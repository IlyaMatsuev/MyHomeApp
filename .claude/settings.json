{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(xcodebuild:*)",
      "Bash(xcrun:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift package:*)",
      "Bash(swiftlint:*)",
      "Bash(swiftformat:*)",
      "Bash(swift-format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(plutil:*)",
      "Bash(open -a Simulator)",
      "WebSearch",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:swift.org)",
      "WebFetch(domain:swiftpackageindex.com)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "enabledPlugins": {
    "ios-simulator-skill@conorluddy": true,
    "ponytail@ponytail": true,
    "superpowers@claude-plugins-official": false,
    "postman@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "conorluddy": {
      "source": {
        "source": "github",
        "repo": "conorluddy/ios-simulator-skill"
      }
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/swiftlint-gate.sh\"",
            "timeout": 120,
            "statusMessage": "Checking SwiftLint"
          }
        ]
      }
    ]
  }
}
